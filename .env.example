# Public address of the site: canonical and hreflang links
SITE_URL=https://example.com

# PostgreSQL. Without it the dev server uses an embedded database in .data/
DATABASE_URL=postgres://user:password@host:5432/miufi

# First administrator, created on start when there is none yet
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=Адміністратор

# Salt for hashing visitor IPs (rate limiting of the forms)
IP_HASH_SALT=change-me

# Cloudflare Turnstile captcha (optional; on only when both keys are set)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
